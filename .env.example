# --- himitsu-vault / OpenBao (docker-compose.openbao.yml) ---
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Host port the OpenBao API/UI is published on.
# docker-compose.local.yml overrides the published port to 8220.
OPENBAO_HOST_PORT=8210

# Advertised API address - must match how clients actually reach the server.
OPENBAO_API_ADDR=http://127.0.0.1:8220

# Static auto-unseal key: 32 random bytes, base64.
#   head -c 32 /dev/urandom | base64
# WARNING: losing this makes the raft storage under the 'openbao-file' volume
# permanently unrecoverable. There are no Shamir shares and no recovery key.
HIMITSU_UNSEAL_KEY=

# Bootstrap admin (userpass), created by the initialize "authentication" stanza
# in config/openbao.hcl on first start.
HIMITSU_ADMIN_USERNAME=admin
HIMITSU_ADMIN_PASSWORD=
