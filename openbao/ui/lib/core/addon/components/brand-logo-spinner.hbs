{{!
  Loading indicator.

  Built from the product's own hexagon mark rather than a generic spinner, so the
  loading state reads as part of the product. The three concentric elements pulse
  in sequence (outer shell, inner shell, core) which gives the "working" cue
  without spinning, and degrades to a static mark if animation is reduced.

  Colours come from the design tokens, so this follows the active theme.
}}
<svg
  id="brand-loading"
  width="48"
  height="48"
  viewBox="0 0 32 32"
  role="img"
  aria-label="Loading"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="brandLoadingStroke" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--hv-violet-glow)" />
      <stop offset="100%" stop-color="var(--hv-violet)" />
    </linearGradient>
  </defs>

  {{! outer shell }}
  <path
    class="brand-loading-order-1"
    d="M16 2 L28 9 L28 23 L16 30 L4 23 L4 9 Z"
    fill="none"
    stroke="url(#brandLoadingStroke)"
    stroke-width="1.2"
    stroke-linejoin="round"
  ></path>

  {{! inner shell }}
  <path
    class="brand-loading-order-2"
    d="M16 9 L22 12.5 L22 19.5 L16 23 L10 19.5 L10 12.5 Z"
    fill="none"
    stroke="var(--hv-violet-glow)"
    stroke-width="0.8"
  ></path>

  {{! core }}
  <circle class="brand-loading-order-3" cx="16" cy="16" r="2.4" fill="url(#brandLoadingStroke)"></circle>
</svg>